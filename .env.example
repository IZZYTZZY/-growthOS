# =============================================================
#  .env.local — Copy this file and fill in your values.
#  NEVER commit .env.local to git.
# =============================================================

# ── Supabase ──────────────────────────────────────────────────
# Found at: https://app.supabase.com → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Service role key — only used server-side (analytics ingestion, admin ops)
# NEVER expose this to the browser
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ── OpenAI ────────────────────────────────────────────────────
# Leave blank to use the built-in template fallback (no cost, no API needed)
OPENAI_API_KEY=sk-...

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Token encryption ─────────────────────────────────────────
# Used by pgcrypto to encrypt Instagram access tokens at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET

# ── Vercel CRON protection ────────────────────────────────────
# Sent as x-cron-secret header by Vercel CRON jobs
# Generate with: openssl rand -hex 32
CRON_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET
